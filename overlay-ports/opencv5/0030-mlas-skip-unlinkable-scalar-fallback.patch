diff --git a/3rdparty/mlas/CMakeLists.txt b/3rdparty/mlas/CMakeLists.txt
index c773ec0..a473585 100644
--- a/3rdparty/mlas/CMakeLists.txt
+++ b/3rdparty/mlas/CMakeLists.txt
@@ -223,11 +223,26 @@ if(MLAS_RISCV64)
   list(APPEND mlas_platform_srcs ${MLAS_SRC_DIR}/scalar/SgemmKernelScalar.cpp)
 endif()
 
-# WASM / unknown archs use the scalar sgemm path; link its kernel.
+# WASM / unknown archs: the vendored scalar fallback cannot link, so skip MLAS
+# and let DNN use its built-in SGEMM (same semantics as the ASM gate above):
+#   * scalar/SgemvKernelScalar.cpp (the only portable MlasGemvFloatKernel) is
+#     not part of that fallback -> LNK2019 on MlasGemvFloatKernel;
+#   * MlasHGemmSupported() is called unconditionally from compute.cpp but has
+#     no definition anywhere in this vendored subset -> LNK2019 on every
+#     architecture once MLAS is actually enabled (verified against GCC and
+#     MSVC object files; the green platforms all skip MLAS via the ASM gate).
+# This is what MSVC/ARM64 hits: CMAKE_SYSTEM_PROCESSOR is "ARM64", which
+# matches none of the case-sensitive arch regexes above, so it lands here with
+# _MLAS_REQUIRES_ASM=FALSE and would otherwise build the broken fallback.
 if(MLAS_WASM OR NOT (MLAS_X86 OR MLAS_X86_64 OR MLAS_ARM OR MLAS_ARM64
                      OR MLAS_POWER OR MLAS_LOONGARCH64 OR MLAS_S390X
                      OR MLAS_RISCV64))
-  list(APPEND mlas_platform_srcs ${MLAS_SRC_DIR}/scalar/SgemmKernelScalar.cpp)
+  set(OPENCV_DNN_MLAS_SKIP_REASON
+      "unsupported processor '${CMAKE_SYSTEM_PROCESSOR}' for the vendored MLAS"
+      CACHE INTERNAL "" FORCE)
+  message(WARNING "MLAS: unsupported processor '${CMAKE_SYSTEM_PROCESSOR}'; "
+                  "MLAS disabled (DNN will use its built-in SGEMM)")
+  return()
 endif()
 
 add_library(opencv_dnn_mlas OBJECT ${mlas_common_srcs} ${mlas_platform_srcs})
